"""Setuptools configuration for the NetworkSecurity package."""

from pathlib import Path

from setuptools import find_packages, setup


PROJECT_ROOT = Path(__file__).resolve().parent
REQUIREMENTS_FILE = PROJECT_ROOT / "requirements.txt"

print(PROJECT_ROOT)
print(REQUIREMENTS_FILE)


def get_requirements(file_path: Path = REQUIREMENTS_FILE) -> list[str]:
    """Read install requirements from a pip-style requirements file.

    Blank lines, full-line comments, and the editable self-install entry are
    ignored. This file should contain dependency specifiers only; pip options
    and nested requirement files belong in environment/CI configuration.
    """
    if not file_path.is_file():
        raise FileNotFoundError(f"Requirements file not found: {file_path}")

    requirements: list[str] = []
    with file_path.open(encoding="utf-8") as requirements_file:
        for line_number, raw_line in enumerate(requirements_file, start=1):
            requirement = raw_line.strip()
            if not requirement or requirement.startswith("#"):
                continue
            if requirement in {"-e .", "--editable ."}:
                continue
            if requirement.startswith(("-r ", "--requirement ", "--", "-")):
                raise ValueError(
                    f"Unsupported pip option in {file_path} at line {line_number}: "
                    f"{requirement!r}. Keep install_requires to package requirements."
                )
            requirements.append(requirement)

    return requirements


setup(
    name="NetworkSecurity",
    version="0.0.1",
    description="Network security and machine learning project",
    author="Venkata Sri Harsha",
    author_email="codewithharsha@gmail.com",
    packages=find_packages(exclude=("tests", "tests.*", "docs", "docs.*")),
    install_requires=get_requirements(),
    include_package_data=True,
    zip_safe=False,
)
